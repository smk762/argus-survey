# NOTE: .git is deliberately *not* ignored -- hatch-vcs reads the version from
# git history at build time. Nothing tracked may be ignored either: git would see it
# as deleted, and hatch-vcs would version a dirty tree (0.1.0 shipped as 0.1.1.dev0+…d<date>).
.venv
venv
dist
build
*.egg-info
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov

# Local data and job output: mounted at run time, never baked into the image. Anchored with `/`
# and written so git and Docker agree: an unanchored `data` means any depth to git (tests/data),
# and git can't re-include a file under an excluded directory. Check with
# `git ls-files -ci --exclude-from=.dockerignore`, which must print nothing (#51).
/.env
/data/*
!/data/in
/data/in/*
!/data/in/.gitkeep
/jobs
