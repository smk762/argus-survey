# Copy to .env. compose.yaml reads it (`cp .env.example .env`); outside compose, export what you need
# (not by sourcing the whole file: UID is read-only in bash, so `. .env` fails on it).

# ── Compose host ─────────────────────────────────────────────────────
# Your uid/gid (`id -u`, `id -g`), so job files on the mounts are yours, not root's.
UID=1000
GID=1000
# Host directories compose mounts at /data/in (read-only: point clouds, polygons,
# check points, design surfaces) and /data/jobs (job output). Defaults: ./data/{in,jobs}.
#SURVEY_IN_HOST=/srv/survey/incoming
#SURVEY_JOBS_HOST=/srv/survey/jobs
# Host address the API binds to (127.0.0.1 keeps it off the network).
#SURVEY_BIND=127.0.0.1
# Tag compose gives the image it builds from this checkout.
#SURVEY_IMAGE=argus-survey:local

# ── Server ───────────────────────────────────────────────────────────
# Host port (suite: lens 8100, curator 8101, quarry 8102, forge 8103, proof 8104,
# atlas 8105, safelight/darkroom 8106).
SURVEY_PORT=8107
# Browser origins allowed by `argus-survey serve --cors` (comma-separated).
#SURVEY_CORS_ORIGINS=http://localhost:3000

# ── Safety posture ───────────────────────────────────────────────────
# The API is read-only unless this is 1/true/yes/on: POST /jobs/{id}/{step}
# returns 403 and GET /health reports read_only=true. The CLI needs no flag.
#SURVEY_ALLOW_PROCESS=1

# ── Storage (container paths; the image sets these, compose mounts onto them) ──
SURVEY_DATA_DIR=/data/in
SURVEY_JOBS_DIR=/data/jobs
